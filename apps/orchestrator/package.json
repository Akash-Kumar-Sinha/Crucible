{
  "name": "@crucible/orchestrator",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/http/server.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "cli": "bun src/cli/run-local.ts",
    "serve": "bun src/http/server.ts"
  },
  "dependencies": {
    "@crucible/proto-types": "workspace:*",
    "@crucible/shared-schemas": "workspace:*",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.7.13",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dockerode": "^5.0.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/ioredis": "^5.0.0",
    "@types/pg": "^8.21.0",
    "bun-types": "^1.2.4",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "typescript": "^5.7.3"
  }
