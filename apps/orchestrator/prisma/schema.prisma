datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id           String     @id
  title        String?
  status       String     @default("idle")
  agentState   String     @default("awaiting_model")
  modelSlug    String     @default("nvidia/nemotron-3-nano-30b-a3b:free")
  systemPrompt String?    @db.Text
  metadata     Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  turns        Turn[]
  events       RunEvent[]

  @@index([status])
  @@index([createdAt])
}

model Turn {
  id           String     @id @default(uuid())
  turnNumber   Int
  sessionId    String
  session      Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  thought      String?    @db.Text
  modelOutput  String?    @db.Text
  durationMs   Int?
  createdAt    DateTime   @default(now())

  toolCalls    ToolCall[]

  @@unique([sessionId, turnNumber])
  @@index([sessionId])
}

model ToolCall {
  id           String     @id
  turnId       String
  turn         Turn       @relation(fields: [turnId], references: [id], onDelete: Cascade)

  name         String
  arguments    Json
  status       String     @default("SUCCESS")
  stdout       String?    @db.Text
  stderr       String?    @db.Text
  output       Json?
  error        Json?
  durationMs   Int?
  createdAt    DateTime   @default(now())

  @@index([turnId])
  @@index([name])
}

model RunEvent {
  id             String   @id @default(uuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  sequenceNumber Int
  eventType      String
  payload        Json
  createdAt      DateTime @default(now())

  @@unique([sessionId, sequenceNumber])
  @@index([sessionId])
  @@index([eventType])
}
