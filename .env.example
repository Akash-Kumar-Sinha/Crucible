# ==============================================================================
# Crucible - Self-Hosted AI Agent Execution Harness & Reasoning Orchestrator
# Externalized 12-Factor Environment Configuration
# ==============================================================================

# LLM Gateway Credentials (OpenRouter)
# Required: Enter your OpenRouter API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Default Model Selection (Unified OpenRouter Identifier)
# Examples: openrouter/free, anthropic/claude-3.5-sonnet, openai/gpt-4o, deepseek/deepseek-chat
OPENROUTER_MODEL="openrouter/free"

# Orchestrator Server Ports & Host
PORT=4000
HOST="0.0.0.0"
WEB_PORT=3000

# Execution Adapter Mode (grpc | docker | local)
CRUCIBLE_EXECUTOR="grpc"
CRUCIBLE_GRPC_ADDR="executor-grpc:50051"
CRUCIBLE_GRPC_PORT=50051

# PostgreSQL Database Configuration
POSTGRES_USER="crucible"
POSTGRES_PASSWORD="crucible_secret"
POSTGRES_DB="crucible"
POSTGRES_PORT=5433
DATABASE_URL="postgresql://crucible:crucible_secret@localhost:5433/crucible?schema=public"

# Redis In-Memory Cache Configuration
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Web Frontend URL Configuration
NEXT_PUBLIC_ORCHESTRATOR_URL="http://localhost:4000"
NEXT_PUBLIC_STREAM_URL="http://localhost:4000/stream"

# Self-Hosted LiveKit Real-Time Voice Transport Configuration
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_HTTP_URL="http://localhost:7880"
LIVEKIT_API_KEY="crucible_dev_key"
LIVEKIT_API_SECRET="crucible_livekit_secret_key_32_chars_long"
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"

# Optional Speech-to-Text (STT) Engine Configuration
# If unset, uses deterministic local/mock audio transcription engine
# DEEPGRAM_API_KEY=""
# WHISPER_API_KEY=""
# WHISPER_ENDPOINT_URL="https://api.openai.com/v1/audio/transcriptions"
