{
  "name": "crucible-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "app/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "bun run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fmt": "bunx prettier --write ."
  },
  "dependencies": {
    "nats": "^2.29.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bun-types": "^1.3.14",
    "eslint": "^10.8.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "turbo": "^2.10.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
